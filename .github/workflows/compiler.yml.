name: Compiler Vocello Projet

on:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: vocello-projet-build
  cancel-in-progress: false

jobs:
  construire:
    # Free standard runner ONLY on a public repository; private runs are skipped.
    if: github.event.repository.private == false
    runs-on: macos-26
    timeout-minutes: 90
    env:
      DEVELOPER_DIR: /Applications/Xcode_26.6.app/Contents/Developer
    steps:
      - name: Recuperer la source officielle fixe
        shell: bash
        run: |
          set -euo pipefail
          git clone --quiet https://github.com/PowerBeef/Vocello.git source
          git -C source checkout --detach 4a5a905fa05b1c4daee305defa6bce0a1d1543d5
          xcodebuild -version
          swift --version

      - name: Ajouter le mode Projet personnel
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PYCODE'
          import base64, hashlib, json
          from pathlib import Path
          root = Path('source')
          original = root / 'Sources/Views/Components/BatchGenerationSheet.swift'
          assert hashlib.sha256(original.read_bytes()).hexdigest() == '5492541fcb7a9540a594260cb5919355796fe5f2f3c6e53d8eeff3d5655d6045', 'Source de base differente'
          files = json.loads(base64.b64decode(''))
          for name, encoded in files.items():
              destination = root / name
              assert not Path(name).is_absolute() and '..' not in Path(name).parts
              destination.parent.mkdir(parents=True, exist_ok=True)
              destination.write_bytes(base64.b64decode(encoded))
          progress = root / 'docs/development-progress.md'
          note = '# Personal project extension (not an official release)\n\nSee [voice-project-personal](reference/voice-project-personal.md). Imported projects use sequential single takes, named exports and a durable resume journal. macOS compilation and exporter tests run in this job; real speech and UI acceptance remain local.\n\n'
          progress.write_text(note + progress.read_text(), encoding='utf-8')
          PYCODE

      - name: Installer les outils de compilation gratuits
        working-directory: source
        shell: bash
        run: |
          set -euo pipefail
          brew install xcbeautify shellcheck numpy
          ./scripts/install_pinned_tools.sh
          echo "$HOME/.qwenvoice-pinned-tools/bin" >> "$GITHUB_PATH"
          python3 -c 'import numpy; print(numpy.__version__)'

      - name: Actualiser et verifier les entrees du projet
        working-directory: source
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/refresh_derived_artifacts.py refresh
          ./scripts/regenerate_project.sh

      - name: Tester les exports et la reprise sur de vrais WAV temporaires
        working-directory: source
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p build/scratch/transient
          xcrun swiftc -swift-version 6 -parse-as-library             Sources/Services/VoiceProjectExport.swift             Tests/VoiceProjectExportStandalone/VoiceProjectExportChecks.swift             -o build/scratch/transient/voice-project-checks
          build/scratch/transient/voice-project-checks

      - name: Compiler l'application Apple Silicon
        working-directory: source
        shell: bash
        run: |
          set -euo pipefail
          ./scripts/build.sh build
          scripts/macos_test.sh test

      - name: Preparer l'application personnelle telechargeable
        working-directory: source
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p build/dist/macos/Vocello-Projet-Mac
          ditto build/Vocello.app build/dist/macos/Vocello-Projet-Mac/Vocello-Projet.app
          cp LICENSE build/dist/macos/Vocello-Projet-Mac/LICENSE
          cp docs/reference/voice-project-personal.md build/dist/macos/Vocello-Projet-Mac/NOTES.md
          codesign --verify --deep --strict build/dist/macos/Vocello-Projet-Mac/Vocello-Projet.app
          ditto -c -k --sequesterRsrc --keepParent             build/dist/macos/Vocello-Projet-Mac build/dist/macos/Vocello-Projet-Mac.zip
          shasum -a 256 build/dist/macos/Vocello-Projet-Mac.zip

      - name: Telecharger depuis les artefacts de cette execution
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1, pinned upstream
        with:
          name: Vocello-Projet-Mac
          path: source/build/dist/macos/Vocello-Projet-Mac.zip
          if-no-files-found: error
          compression-level: 0
          retention-days: 14
